# Copy to .env and fill in. NEVER commit .env.
#
# Both cookies come from a browser already logged into LinkedIn:
#   DevTools -> Application -> Cookies -> https://www.linkedin.com

# li_at is the session/auth cookie (long-lived, ~1 year).
LI_AT=

# JSESSIONID including the "ajax:" prefix, WITHOUT the surrounding quotes.
# LinkedIn requires the csrf-token header to equal this cookie value.
LI_JSESSIONID=ajax:0000000000000000000

# Optional: comma-separated API keys. If set, callers must send X-API-Key.
API_KEYS=

PORT=8000
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Global caps on requests that actually reach LinkedIn, across every caller and
# every route. The per-IP limit above can be evaded by rotating addresses;
# these cannot. 0 disables.
UPSTREAM_HOURLY_BUDGET=20
UPSTREAM_DAILY_BUDGET=100
UPSTREAM_CONCURRENCY=4
UPSTREAM_TIMEOUT_SECONDS=30
MIN_SECONDS_BETWEEN_PROFILES=10
LOG_LEVEL=info
